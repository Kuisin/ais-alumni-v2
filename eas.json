{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" },
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ais-alumni-dev.kai-lab.net"
      }
    },
    "preview": {
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ais-alumni-dev.kai-lab.net"
      }
    },
    "production": {
      "ios": { "image": "macos-tahoe-26.6-xcode-27.1" },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ais-alumni.kai-lab.net"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ais-alumni-dev.kai-lab.net"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817619381",
        "appleTeamId": "83BJ8C4G93"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
