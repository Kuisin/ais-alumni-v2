+// AIS Alumni: started on the iPhone Duo's open display, the tabs are
+// missing from the vertical bar until the Duo is folded and opened again,
+// which makes UIKit recompute the vertical bar. Ask for the same update
+// once the controller is on screen, and again after the first layout and
+// hinge updates have settled.
+- (void)viewDidAppear:(BOOL)animated
+{
+  [super viewDidAppear:animated];
+#if defined(__IPHONE_27_1) && __IPHONE_OS_VERSION_MAX_ALLOWED >= __IPHONE_27_1
+  if (@available(iOS 27.1, *)) {
+    __weak __typeof(self) weakSelf = self;
+    void (^refresh)(void) = ^{
+      __typeof(self) strongSelf = weakSelf;
+      if (!strongSelf) {
+        return;
+      }
+      // What folding and opening does: the size class changes and the tab
+      // bar is laid out again.
+      if (UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPhone) {
+        strongSelf.traitOverrides.horizontalSizeClass = UIUserInterfaceSizeClassRegular;
+        strongSelf.traitOverrides.horizontalSizeClass = UIUserInterfaceSizeClassCompact;
+      }
+      if (!strongSelf.tabBarHidden) {
+        [strongSelf setTabBarHidden:YES animated:NO];
+        [strongSelf setTabBarHidden:NO animated:NO];
+      }
+      [strongSelf setNeedsUpdateOfVerticalBarConfiguration];
+      [strongSelf.selectedViewController setNeedsUpdateOfVerticalBarConfiguration];
+      [strongSelf.view setNeedsLayout];
+      [strongSelf.view layoutIfNeeded];
+    };
+    refresh();
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), refresh);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), refresh);
+  }
+#endif
+}
