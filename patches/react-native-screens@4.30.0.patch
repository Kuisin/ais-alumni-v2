diff --git a/ios/tabs/host/RNSTabBarController.mm b/ios/tabs/host/RNSTabBarController.mm
index bc9c64436da76959ecdc22539b94ce459e1e4ed2..e75bbb350a80aa63132763cd568e8c2bc178f0e0 100644
--- a/ios/tabs/host/RNSTabBarController.mm	
+++ b/ios/tabs/host/RNSTabBarController.mm
@@ -137,6 +137,16 @@ static void rns_pushViewController(__unsafe_unretained id self,
 
     // Delegate field retains weakly, no risk of cycle.
     self.delegate = self;
+
+    // AIS Alumni: on iPhones keep the compact tab bar — the system's icon
+    // bar (at the side on the iPhone Duo) — also where the window is
+    // regular width (the Duo's open display, Pro Max landscape), instead of
+    // a sidebar there.
+    if (@available(iOS 17.0, *)) {
+      if (UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPhone) {
+        self.traitOverrides.horizontalSizeClass = UIUserInterfaceSizeClassCompact;
+      }
+    }
   }
   return self;
 }
